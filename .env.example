# Copy to .env for running scripts on your laptop. Never commit .env.
# Values come from Key Vault (kv-fi-xxxxxx) in rg-flightinsight-core.
SQL_CONNECTION_STRING=
DATA_LAKE_URL=https://stfilakexxxxxx.dfs.core.windows.net/
COSMOS_NOSQL_ENDPOINT=
COSMOS_NOSQL_KEY=
COSMOS_GREMLIN_ENDPOINT=
COSMOS_GREMLIN_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Agent chat model (app/agent): Gemini key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
OLLAMA_CHAT_MODEL=qwen2.5:7b
