<?xml version="1.0" encoding="utf-8"?>
<!-- SDK-style SQL Database Project. Every .sql file under this folder is part of the build,
     except deployment scripts in Scripts/. `dotnet build` produces bin/<Config>/FlightInsight.dacpac. -->
<Project Sdk="Microsoft.Build.Sql/1.0.0">
  <PropertyGroup>
    <Name>FlightInsight</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="Scripts\**" />
    <PostDeploy Include="Scripts\PostDeployment.sql" />
  </ItemGroup>
</Project>
